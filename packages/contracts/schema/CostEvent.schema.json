{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "costEventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "enum": [
        "explain_block",
        "rephrase_explanation",
        "draft_worked_example",
        "draft_completion_prompt",
        "draft_self_explanation_prompt",
        "classify_student_error",
        "classify_question_scope",
        "draft_feedback",
        "create_authoring_candidate",
        "critique_authoring_candidate",
        "interpret_visual_context"
      ]
    },
    "profile": {
      "type": "string",
      "enum": [
        "SESION",
        "AUTORIA"
      ]
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "bindingId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "pricingManifestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "tokensIn": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tokensOut": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tokensCached": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "audioSeconds": {
      "default": 0,
      "type": "number",
      "minimum": 0
    },
    "images": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "attempts": {
      "default": 1,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "retries": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "failures": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "latencyLocalMs": {
      "type": "number",
      "minimum": 0
    },
    "latencyProviderMs": {
      "type": "number",
      "minimum": 0
    },
    "costCalculated": {
      "type": "number",
      "minimum": 0
    },
    "costReported": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "pseudonymousSubjectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "costEventId",
    "occurredAt",
    "stage",
    "provider",
    "pricingManifestId",
    "costCalculated",
    "currency"
  ]
}
