{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "manifestVersion": {
      "type": "string",
      "const": "1"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "contentPackageHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorizedCalculusVersion": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "artifactId",
        "version"
      ]
    },
    "artifacts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "path",
          "hash",
          "bytes"
        ],
        "additionalProperties": false
      }
    },
    "capabilityFlags": {
      "type": "object",
      "properties": {
        "voiceInput": {
          "type": "boolean"
        },
        "voiceOutput": {
          "type": "boolean"
        },
        "whiteboard": {
          "type": "boolean"
        },
        "visualBoardInterpretation": {
          "type": "boolean"
        },
        "uiAnnotations": {
          "type": "boolean"
        },
        "internalUiCapture": {
