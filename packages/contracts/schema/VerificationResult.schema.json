{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "valid": {
      "type": "boolean"
    },
    "firstInvalidStep": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "E-SYN-PARSE",
              "E-SYN-PRECEDENCE",
              "E-SYN-ALIAS",
              "E-SYN-SYMBOL",
              "E-RULE-UNKNOWN",
              "E-RULE-FORBIDDEN",
              "E-RULE-ARITY",
              "E-RULE-SHAPE",
              "E-RULE-MAINOP",
              "E-REF-FORWARD",
              "E-REF-CLOSED",
              "E-REF-SUBPROOF-INCOMPLETE",
              "E-REF-SUBPROOF-NESTED-CLOSED",
              "E-STRUCT-AS-POSITION",
              "E-STRUCT-PR-POSITION",
              "E-STRUCT-OPEN-ASSUMPTION",
              "E-STRUCT-CONCLUSION-DEPTH",
              "E-SEM-UNSOUND-STEP"
            ]
          },
          "line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "ruleId": {
            "type": "string",
            "enum": [
              "R",
              "∧I",
              "∧E",
              "∨I",
              "∨E",
              "→I",
              "→E",
              "↔I",
              "↔E",
              "¬I",
              "¬E",
              "X",
              "IP",
              "DNE"
            ]
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "kcId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "trace": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      }
    },
    "semanticCheck": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "not-applicable"
      ]
    },
    "semanticCheckReason": {
      "type": "string"
    },
    "authorizedCalculusVersion": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "artifactId",
        "version"
      ]
    },
    "verifierVersion": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "artifactId",
        "version"
      ]
    }
  },
  "required": [
    "valid",
    "errors",
    "semanticCheck",
    "authorizedCalculusVersion",
    "verifierVersion"
  ]
}
