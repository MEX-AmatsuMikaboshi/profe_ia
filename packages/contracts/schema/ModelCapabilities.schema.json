{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "supportedParameters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rejectedParameters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "structuredOutput": {
      "type": "object",
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "maxSchemaDepth": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "supported"
      ]
    },
    "reasoning": {
      "type": "object",
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "supported"
      ]
    },
    "batch": {
      "type": "object",
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "supported"
      ]
    },
    "caching": {
      "type": "object",
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "ttlSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "supported"
      ]
    },
    "dataPolicy": {
      "type": "object",
      "properties": {
        "region": {
