        }
      },
      "required": [
        "contractualEligibility"
      ]
    },
    "limits": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "failureCodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
