{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "opportunityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "probeRoundId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "plannedItems": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "validScoredItems": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "correctValidItems": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "observation": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "operationalValidity": {
      "type": "string",
      "enum": [
        "valid",
        "invalid",
        "missing"
      ]
    },
    "reasonCode": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "opportunityId",
    "probeRoundId",
    "plannedItems",
    "validScoredItems",
    "correctValidItems",
    "observation",
    "operationalValidity",
    "reasonCode"
  ],
  "additionalProperties": false
}
