{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "incidentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "incidentCode": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        },
        {
          "type": "number",
          "const": 3
        }
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "registrar_y_continuar",
        "invalidar_acto_o_bloque",
        "suspender_piloto"
      ]
    },
    "detectedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "affectedEventIds": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "invalidatedOpportunityIds": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "responsibleRole": {
      "type": "string",
      "enum": [
        "SYSTEM_OWNER",
        "CORPUS_APPROVER",
        "TECHNICAL_AUDITOR",
        "EXPERIMENT_AUDITOR",
        "SECURITY_PRIVACY_RESPONSIBLE",
        "PROFESSIONAL_REVIEWER"
      ]
    },
    "approverRole": {
      "type": "string",
      "enum": [
        "SYSTEM_OWNER",
        "CORPUS_APPROVER",
        "TECHNICAL_AUDITOR",
        "EXPERIMENT_AUDITOR",
        "SECURITY_PRIVACY_RESPONSIBLE",
        "PROFESSIONAL_REVIEWER"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "incidentId",
    "incidentCode",
    "level",
    "action",
    "detectedAt"
  ]
}
