{
  "name": "@profesor-ia/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "JSON Schema + Zod compartidos (T-H0-03).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "emit:json-schema": "tsc -p tsconfig.json && node dist/emit-json-schema.js"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
