# Plantilla de `infra/compose/.env` (Plan.md T-H3-01).
#
# **`.env` no se versiona.** Este archivo solo declara qué variables hacen falta;
# los valores los genera `pnpm run dev:env` y, en cuanto Infisical esté
# inicializado, los secretos de servicio pasan a leerse de ahí (T-H3-04).
#
# Ninguna variable tiene valor por omisión en el compose: si falta, el arranque
# **falla**. Un secreto con valor por defecto es un secreto compartido.

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_DB=profesor_ia
POSTGRES_USER=profesor_admin
POSTGRES_PASSWORD=

# Base separada para Infisical dentro de la misma instancia.
INFISICAL_DB=infisical

# --- Roles de servicio (P-II §11.2) -------------------------------------
# Uno por servicio: comparten instancia, no credenciales.
SVC_API_PASSWORD=
SVC_SESSION_PASSWORD=
SVC_VERIFIER_PASSWORD=
SVC_AUTHORING_PASSWORD=
SVC_MEASUREMENT_PASSWORD=
SVC_BACKGROUND_PASSWORD=
SVC_AUDIT_PASSWORD=

# --- Infisical ----------------------------------------------------------
# `ENCRYPTION_KEY`: 16 bytes en hex. `AUTH_SECRET`: 32 bytes en base64.
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=
INFISICAL_PORT=8080

# --- Puertos publicados (solo a 127.0.0.1) ------------------------------
WEB_PORT=3000
API_PORT=3001

# --- Copias de seguridad ------------------------------------------------
BACKUP_NAME=profesor_ia
