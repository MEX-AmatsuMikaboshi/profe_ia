# Plantilla de `infra/compose/.env` (Plan.md T-H3-01).
#
# **`.env` no se versiona.** Este archivo solo declara qué variables hacen falta;
# los valores los genera `pnpm run dev:env` y, en cuanto Infisical esté
# inicializado, los secretos de servicio pasan a leerse de ahí (T-H3-04).
#
# Ninguna variable tiene valor por omisión en el compose: si falta, el arranque
# **falla**. Un secreto con valor por defecto es un secreto compartido.

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_DB=profesor_ia
POSTGRES_USER=profesor_admin
POSTGRES_PASSWORD=

# Base separada para Infisical dentro de la misma instancia.
INFISICAL_DB=infisical

# --- Roles de servicio (P-II §11.2) -------------------------------------
# Uno por servicio: comparten instancia, no credenciales.
SVC_API_PASSWORD=
SVC_SESSION_PASSWORD=
SVC_VERIFIER_PASSWORD=
SVC_AUTHORING_PASSWORD=
SVC_MEASUREMENT_PASSWORD=
SVC_BACKGROUND_PASSWORD=
SVC_AUDIT_PASSWORD=

# --- Infisical ----------------------------------------------------------
# `ENCRYPTION_KEY`: 16 bytes en hex. `AUTH_SECRET`: 32 bytes en base64.
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=
INFISICAL_PORT=8080

# --- Puertos publicados (solo a 127.0.0.1) ------------------------------
WEB_PORT=3000
API_PORT=3001

# --- Credenciales de proveedor de modelo (T-H4-09) ----------------------
# **Modo de arranque, no de destino**: cuando Infisical esté inicializado los
# servicios leen de ahí (T-H3-04). Nombre: MODEL_CREDENTIAL_<PROVEEDOR>_<PERFIL>.
#
# Son DOS claves por proveedor, no una. P-II §8.2 congela que `SESION` y
# `AUTORIA` usan credenciales separadas, y la separación solo protege de algo si
# las cadenas son distintas de verdad: la pasarela está escrita para que quien
# tenga la de un perfil no tenga ningún camino hacia la del otro. En la consola
# del proveedor se crean sobre el mismo saldo, sin costo extra.
#
# `pnpm run dev:env` NO las genera —no son secretos aleatorios, son credenciales
# externas— y te las lista como pendientes al terminar. Se pegan a mano aquí.
# Vacías, la pasarela falla con MissingCredentialError: nunca cae a otra.
MODEL_CREDENTIAL_ANTHROPIC_SESION=
MODEL_CREDENTIAL_ANTHROPIC_AUTORIA=

# OpenAI hace falta para BENCH-02 (T-H4-11): generador y crítico deben ser de
# familias distintas. Se puede empezar solo con Anthropic y dejarlas vacías.
MODEL_CREDENTIAL_OPENAI_SESION=
MODEL_CREDENTIAL_OPENAI_AUTORIA=

# --- Copias de seguridad ------------------------------------------------
BACKUP_NAME=profesor_ia
